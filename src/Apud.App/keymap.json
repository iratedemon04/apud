// Apud keymap — every keyboard shortcut, user-editable. Restart to apply.
//
// Format: "command-id": "chord".
//   Chord = optional modifiers Ctrl, Alt, Shift joined with '+', then one key:
//   A-Z, 0-9, F1-F24, Enter, Escape (Esc), Tab, Space, Delete (Del),
//   Insert (Ins), Backspace, Home, End, PageUp (PgUp), PageDown (PgDn),
//   Up, Down, Left, Right.   Examples: "Ctrl+L", "Shift+F6", "F2".
// "" unbinds a command. A missing entry (or missing file) = built-in default.
// A bad entry is reported in the message bar and the default kept — never a crash.
// Plain unmodified letters/digits only fire while no text box has the cursor.
//
// Menu-only commands (bindable here if you want keys for them):
//   catalogue.new, catalogue.open, catalogue.import-folder,
//   catalogue.export-base, catalogue.export-selected, base.bib, base.aut,
//   help.about
{
  "search.focus": "F2",
  "record.new": "Ctrl+N",
  "record.save-draft": "Ctrl+S",
  "record.save-template": "Ctrl+T",
  "record.undo": "Ctrl+Z",
  "record.redo": "Ctrl+Y",
  "field.new": "F6",
  "subfield.new": "F7",
  "field.delete": "Ctrl+F5",
  "subfield.delete": "Ctrl+F7",
  "field.fixed-edit": "Ctrl+F3",
  "field.validate": "Ctrl+F4",
  "record.validate": "Ctrl+W",
  "record.push": "Ctrl+L",
  "app.exit": "Alt+F4"
}
